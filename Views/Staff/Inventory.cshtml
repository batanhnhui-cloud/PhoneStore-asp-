@model IEnumerable<PhoneStore.Controllers.InventoryProductVM>
@{
    ViewData["Title"] = "Thống kê Tồn kho";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success fw-bold shadow-sm rounded-4"><i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger fw-bold shadow-sm rounded-4"><i class="fa fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]</div> }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark m-0"><i class="fa fa-boxes text-primary me-2"></i>Quản lý Tồn Kho Tổng</h3>
        <div class="d-flex gap-2">
            <form method="get" asp-action="Inventory" class="d-flex align-items-center bg-white rounded-pill px-2 py-1 shadow-sm border">
                <i class="fa fa-filter text-muted ms-2"></i>
                <select name="searchBranchId" class="form-select border-0 shadow-none fw-bold text-dark" style="min-width: 200px;" onchange="this.form.submit()">
                    <option value="">-- Tất cả chi nhánh --</option>
                    @foreach (var branch in ViewBag.Branches)
                    {
                        if (branch.Selected) { <option value="@branch.Value" selected>@branch.Text</option> }
                        else { <option value="@branch.Value">@branch.Text</option> }
                    }
                </select>
            </form>
            <a asp-action="ImportImei" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center">
                <i class="fa fa-plus me-2"></i> Nhập kho mới
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover align-middle mb-0" style="border-collapse: collapse;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" width="40%">Sản phẩm (SKU)</th>
                        <th class="text-center" width="20%">Phân bổ kho</th>
                        <th class="text-center" width="20%">Tổng Tồn</th>
                        <th class="text-end pe-4" width="20%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="fw-bold">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/40" : item.ImageUrl)" class="rounded-3 border me-3" style="width: 45px; height: 45px; object-fit: cover;" />
                                        <span class="text-dark fs-6">@item.ProductName</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                        <i class="fa fa-map-marker-alt text-primary me-1"></i> @item.BranchStocks.Count chi nhánh
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-dark px-3 py-2 rounded-pill fs-6 shadow-sm">@item.TotalStock máy</span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary fw-bold rounded-pill px-3 collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.ProductId" aria-expanded="false">
                                        Chi tiết <i class="fa fa-chevron-down ms-1"></i>
                                    </button>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="4" class="p-0 border-0">
                                    <div class="collapse" id="collapse-@item.ProductId">
                                        <div class="p-4 bg-light border-bottom border-top" style="box-shadow: inset 0 3px 5px rgba(0,0,0,0.02);">
                                            <h6 class="fw-bold text-muted mb-3 text-uppercase" style="font-size: 0.8rem;"><i class="fa fa-sitemap me-2"></i>Chi tiết phân bổ tại các kho</h6>
                                            
                                            <div class="row g-3">
                                                @foreach (var branch in item.BranchStocks)
                                                {
                                                    <div class="col-md-6 col-lg-4">
                                                        <div class="card border-0 shadow-sm rounded-3">
                                                            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <div class="fw-bold text-dark"><i class="fa fa-store text-warning me-2"></i>@branch.BranchName</div>
                                                                    <div class="text-danger fw-bold mt-1">Sẵn sàng: @branch.Quantity máy</div>
                                                                </div>
                                                                <a asp-action="ImeiDetails" asp-route-branchId="@branch.BranchId" asp-route-productId="@item.ProductId" class="btn btn-sm btn-light border fw-bold rounded-circle" title="Xem mã IMEI" style="width: 40px; height: 40px; line-height: 28px;">
                                                                    <i class="fa fa-barcode text-dark"></i>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center text-muted py-5"><i class="fa fa-box-open fs-1 d-block mb-3 opacity-25"></i>Không có sản phẩm nào trong kho.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Xoay icon khi xổ xuống */
    button[data-bs-toggle="collapse"]:not(.collapsed) i.fa-chevron-down {
        transform: rotate(180deg);
        transition: transform 0.3s ease;
    }
    button[data-bs-toggle="collapse"].collapsed i.fa-chevron-down {
        transform: rotate(0deg);
        transition: transform 0.3s ease;
    }
</style>