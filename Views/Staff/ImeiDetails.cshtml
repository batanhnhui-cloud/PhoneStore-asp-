@model IEnumerable<PhoneStore.Models.DeviceImei>
@{
    ViewData["Title"] = "Chi tiết IMEI - SunMobile";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int stt = 1;
}

<div class="container-fluid py-4">
    <a href="/Staff/Inventory" class="btn btn-light fw-bold mb-3 shadow-sm rounded-pill px-3">
        <i class="fa fa-arrow-left me-2"></i> Quay lại Tồn Kho
    </a>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center rounded-top-4">
            <div>
                <h4 class="fw-bolder text-primary mb-1">@ViewBag.ProductName</h4>
                <p class="mb-0 text-muted"><i class="fa fa-store me-1"></i> Kho đang chứa: <strong>@ViewBag.BranchName</strong></p>
            </div>
            <div class="badge bg-success bg-opacity-10 text-success px-4 py-2 fs-5 rounded-pill border border-success border-opacity-25">
                Tổng: @Model.Count() máy
            </div>
        </div>
        
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3">STT</th>
                        <th class="py-3">Mã IMEI (15 Số)</th>
                        <th class="py-3">Thuộc Kiện Hàng (Thùng)</th>
                        <th class="pe-4 py-3 text-end">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var device in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted">@(stt++)</td>
                            <td>
                                <span class="fw-bold font-monospace fs-5 text-dark">
                                    <i class="fa fa-barcode text-muted me-2"></i>@device.Imei
                                </span>
                            </td>
                            <td>
                                @if (string.IsNullOrEmpty(device.MasterBarcode))
                                {
                                    <span class="badge bg-secondary rounded-pill"><i class="fa fa-keyboard me-1"></i> Nhập lẻ tay</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark rounded-pill"><i class="fa fa-box me-1"></i> @device.MasterBarcode</span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <span class="badge bg-success rounded-pill px-3 py-2"><i class="fa fa-check-circle me-1"></i> Sẵn sàng bán</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>