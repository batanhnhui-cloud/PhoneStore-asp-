@model IEnumerable<PhoneStore.Controllers.CustomerViewModel>
@{
    ViewData["Title"] = "Quản lý Khách hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <h3 class="fw-bold text-dark mb-4"><i class="fa fa-users text-primary me-2"></i>Quản lý Khách hàng CRM</h3>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success fw-bold"><i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Họ Tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Hạng</th>
                        <th>Tổng chi tiêu</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.PhoneNumber</td>
                                <td><span class="badge bg-warning text-dark">@item.Rank</span></td>
                                <td class="text-danger fw-bold">@item.TotalSpent.ToString("N0") đ</td>
                                <td class="text-end pe-4">
                                    <a asp-controller="Staff" asp-action="EditCustomer" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                        <i class="fa fa-edit"></i> Xem / Sửa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Chưa có dữ liệu khách hàng.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>