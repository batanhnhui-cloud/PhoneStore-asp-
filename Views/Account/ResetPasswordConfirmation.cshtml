@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}
<div class="container mt-5 text-center">
    <div class="card shadow-sm border-0 p-5">
        <h3 class="text-success fw-bold"><i class="fa fa-check-circle fa-2x mb-3"></i><br />Đổi mật khẩu thành công!</h3>
        <p class="text-muted">Bạn đã cập nhật mật khẩu mới. Bây giờ bạn có thể đăng nhập vào hệ thống.</p>
        <a asp-action="Login" class="btn btn-primary mt-3">Đăng nhập ngay</a>
    </div>
</div>