@model PhoneStore.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow-sm border-0 rounded-4 p-4">
        <h4 class="fw-bold mb-3 text-center">Quên mật khẩu</h4>
        <p class="text-muted small text-center mb-4">Nhập email đăng ký của bạn, chúng tôi sẽ gửi link đặt lại mật khẩu.</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold">Email</label>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold py-2">Gửi yêu cầu</button>
            <div class="text-center mt-3">
                <a asp-action="Login" class="text-decoration-none small">Quay lại đăng nhập</a>
            </div>
        </form>
    </div>
</div>